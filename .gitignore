# Dependencies (installed by `npm install`, never committed)
node_modules/

# Build output. `lib/` is generated by `npm run bundle`; the DSH loader serves
# lib/client.js from disk, so a clone must be built before it can be installed.
# Committing it would ship a stale artifact that silently diverges from src/.
lib/

# Local build scratch
*.tsbuildinfo
.tsdown/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and local scratch
*.log
npm-debug.log*
