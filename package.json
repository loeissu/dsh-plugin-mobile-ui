{
  "name": "dsh-plugin-mobile-ui",
  "version": "0.1.0",
  "description": "Mobile-first UI for the DeepSeek Harness Web client, delivered as an official DSH client plugin (slot-based, no fork)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "android",
    "cordis",
    "slot"
  ],
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prebundle": "node check-css-backticks.mjs",
    "bundle": "tsdown",
    "verify": "node verify-bundle.mjs lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.6.0"
  }
}
