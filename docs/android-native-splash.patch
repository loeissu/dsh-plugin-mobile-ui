+      mirrors the light structure with the dark light-status-bar flag; the
+      colors themselves resolve per configuration through values-night.
+    -->
     <style name="Theme.dsh_tether_app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
-        <!-- Customize your theme here. -->
+        <item name="android:windowBackground">@color/window_background</item>
+        <item name="android:navigationBarColor">@android:color/transparent</item>
+        <item name="android:statusBarColor">@android:color/transparent</item>
+        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
     </style>
+
+    <!-- The launch theme needs no night declaration: windowSplashScreenBackground
+         and the mark resolve through the values-night color resources. -->
+
 </resources>
diff --git a/app/src-tauri/gen/android/app/src/main/res/values/splash.xml b/app/src-tauri/gen/android/app/src/main/res/values/splash.xml
new file mode 100644
index 0000000..2f2a1dc
--- /dev/null
+++ b/app/src-tauri/gen/android/app/src/main/res/values/splash.xml
@@ -0,0 +1,28 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Android launch-screen colors.
+
+  These must match the Web UI's own boot surface, which DSH defines as
+  the boot background token (#fff light, #151517 dark) in its shipped
+  frontend. Keeping the native window background identical to the HTML boot
+  background is what removes the white flash between the system splash and the
+  first painted frame.
+
+  The accent matches DSH's brand accent alias (light #4176E6, dark
+  rgb(86,134,254) = #5686FE), so the mark drawn natively and the mark drawn by
+  the client plugin are the same color.
+
+  NOTE: Android XML comments may not contain a double hyphen, so DSH's own
+  custom-property names (which are written with that prefix) cannot be quoted
+  verbatim here.
+-->
+<resources>
+    <!-- Launch screen background: identical to DSH's boot surface. -->
+    <color name="splash_background">#FFFFFFFF</color>
+    <!-- Brand mark stroke. -->
+    <color name="splash_mark">#FF4176E6</color>
+
+    <!-- Base window background. Equal to splash_background so the handoff from
+         the splash to the WebView has no visible seam. -->
+    <color name="window_background">#FFFFFFFF</color>
+</resources>
diff --git a/app/src-tauri/gen/android/app/src/main/res/values/themes.xml b/app/src-tauri/gen/android/app/src/main/res/values/themes.xml
index d43d23c..d4eb6eb 100644
--- a/app/src-tauri/gen/android/app/src/main/res/values/themes.xml
+++ b/app/src-tauri/gen/android/app/src/main/res/values/themes.xml
@@ -1,6 +1,35 @@
+<?xml version="1.0" encoding="utf-8"?>
 <resources xmlns:tools="http://schemas.android.com/tools">
-    <!-- Base application theme. -->
+
+    <!--
+      Base application theme.
+
+      windowBackground is pinned to the same color the launch screen uses, so
+      the window behind the WebView is already the right color the moment the
+      splash hands off. It was previously unset, which is what produced a white
+      flash before the interface painted.
+    -->
     <style name="Theme.dsh_tether_app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
-        <!-- Customize your theme here. -->
+        <item name="android:windowBackground">@color/window_background</item>
+        <item name="android:navigationBarColor">@android:color/transparent</item>
+        <item name="android:statusBarColor">@android:color/transparent</item>
+        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
     </style>
+
+    <!--
+      Launch screen theme, installed by MainActivity via installSplashScreen().
+
+      core-splashscreen backports this to API 24 (the app's minSdk), so the
+      launch path is identical on every supported device and not only on
+      API 31+.
+
+      postSplashScreenTheme must name the base theme; the library swaps to it
+      once the first frame is ready.
+    -->
+    <style name="Theme.dsh_tether_app.Splash" parent="Theme.SplashScreen">
+        <item name="windowSplashScreenBackground">@color/splash_background</item>
+        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
+        <item name="postSplashScreenTheme">@style/Theme.dsh_tether_app</item>
+    </style>
+
 </resources>
