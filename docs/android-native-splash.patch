@@ -1,6 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
 <resources xmlns:tools="http://schemas.android.com/tools">
-    <!-- Base application theme. -->
+
+    <!--
+      Dark-scheme base theme.
+
+      This file previously held a byte-identical copy of the light theme, so the
