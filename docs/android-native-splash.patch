--- a/app/src-tauri/gen/android/app/src/main/java/cc/zexa/dshtether/MainActivity.kt
+++ b/app/src-tauri/gen/android/app/src/main/java/cc/zexa/dshtether/MainActivity.kt
@@ -2,9 +2,15 @@ package cc.zexa.dshtether
 
 import android.os.Bundle
 import androidx.activity.enableEdgeToEdge
+import androidx.core.splashscreen.SplashScreen.Companion.installSplashScreen
 
 class MainActivity : TauriActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
+    // installSplashScreen() must run BEFORE super.onCreate: it swaps the launch
+    // theme for postSplashScreenTheme and holds the launch screen until the
+    // first frame is drawn. Called after super, the activity has already laid
+    // out against the launch theme and the handoff becomes a visible flash.
+    installSplashScreen()
     enableEdgeToEdge()
     super.onCreate(savedInstanceState)
   }
diff --git a/app/src-tauri/gen/android/app/src/main/res/drawable/splash_mark.xml b/app/src-tauri/gen/android/app/src/main/res/drawable/splash_mark.xml
new file mode 100644
index 0000000..eb2c2d7
--- /dev/null
+++ b/app/src-tauri/gen/android/app/src/main/res/drawable/splash_mark.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Launch-screen mark: two overlapping rings.
+
+  This is the same geometry the client plugin's HTML splash draws
+  (Splash.tsx: circles at 19,24 and 29,24 with r=11.5 in a 48 viewport), scaled
+  into a 108x108 viewport and sized to about 41% of the canvas so it stays
+  inside the API 31+ splash icon's visible safe area rather than being cropped
+  by the circular mask.
+
+  Geometry is derived, not eyeballed: the source mark spans 33 units wide in a
+  48 viewport; scale 1.2 about the centre (54,54) yields circles at 46.8 and
+  61.2 with r=13.8 and a 2.88 stroke, a 44.9-unit footprint.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <path
+        android:pathData="M46.8,40.2 A13.8,13.8 0 1,1 46.8,67.8 A13.8,13.8 0 1,1 46.8,40.2 Z"
+        android:strokeColor="@color/splash_mark"
+        android:strokeWidth="2.88"
+        android:strokeAlpha="1.0" />
+
+    <path
+        android:pathData="M61.2,40.2 A13.8,13.8 0 1,1 61.2,67.8 A13.8,13.8 0 1,1 61.2,40.2 Z"
+        android:strokeColor="@color/splash_mark"
+        android:strokeWidth="2.88"
+        android:strokeAlpha="0.7" />
+</vector>
diff --git a/app/src-tauri/gen/android/app/src/main/res/values-night/splash.xml b/app/src-tauri/gen/android/app/src/main/res/values-night/splash.xml
new file mode 100644
index 0000000..a58d152
--- /dev/null
+++ b/app/src-tauri/gen/android/app/src/main/res/values-night/splash.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Android launch-screen colors, dark scheme.
+
+  The dark values mirror DSH's dark boot surface (#151517) and its dark brand
+  accent, so the night launch path shows the same brand as the light one instead
+  of the near-black-on-black the previous empty theme produced.
+-->
+<resources>
+    <color name="splash_background">#FF151517</color>
+    <color name="splash_mark">#FF5686FE</color>
+    <color name="window_background">#FF151517</color>
+</resources>
